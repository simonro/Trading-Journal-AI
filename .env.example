# Claude API key: powers diary analysis, day review, weekly summary, and the Brain chat (get one at console.anthropic.com)
ANTHROPIC_API_KEY=
# Alpaca market-data key id: powers the intraday price charts (free account at alpaca.markets)
APCA_API_KEY_ID=
# Alpaca market-data secret key
APCA_API_SECRET_KEY=
# Optional. Defaults to "iex", which works on a free Alpaca account. Set to "sip"
# only if your key has a paid market-data subscription.
ALPACA_DATA_FEED=

# Required to use encrypted backup/restore and to encrypt backup-destination
# credentials at rest. Pick a strong passphrase and store it somewhere safe -
# it is never written to disk, and you cannot restore a backup without it.
BACKUP_PASSPHRASE=
# Optional: where local encrypted backups are written (default: backend/backups)
BACKUP_LOCAL_DIR=
# Optional: where uploaded TLS cert/key are stored (default: backend/certs)
CERT_DIR=
