# Claude API key: powers diary analysis, day review, weekly summary, and the Brain chat (get one at console.anthropic.com)
ANTHROPIC_API_KEY=
# Alpaca market-data key id: powers the intraday price charts (free account at alpaca.markets)
APCA_API_KEY_ID=
# Alpaca market-data secret key
APCA_API_SECRET_KEY=
# Optional. Defaults to "iex", which works on a free Alpaca account. Set to "sip"
# only if your key has a paid market-data subscription.
ALPACA_DATA_FEED=
# Optional. On start the backend asks GitHub once a day whether a newer release exists and only
# shows a notice. Set to 0 to turn the check off.
UPDATE_CHECK=
