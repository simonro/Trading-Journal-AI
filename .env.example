# Claude API key: powers diary analysis, day review, weekly summary, and the Brain chat (get one at console.anthropic.com)
ANTHROPIC_API_KEY=
# Alpaca market-data key id: powers the intraday price charts (free account at alpaca.markets)
APCA_API_KEY_ID=
# Alpaca market-data secret key
APCA_API_SECRET_KEY=
# Optional. Defaults to "iex", which works on a free Alpaca account. Set to "sip"
# only if your key has a paid market-data subscription.
ALPACA_DATA_FEED=
# Optional. On start the backend asks GitHub once a day whether a newer release exists and only
# shows a notice. Set to 0 to turn the check off.
UPDATE_CHECK=
# Optional. Futures charts (/ES, /MES, /NQ, /MNQ and any contract Schwab lists) read Schwab's price
# history, because Alpaca has no futures. Needs `pip install schwabdev` and a Schwab developer app.
# Either put the app's keys here, or point SCHWAB_ENV_FILE at another app's .env that has them
# (for example Edge Trader for Schwab's, to share one Schwab login).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# SCHWAB_ENV_FILE=
# Optional. Where schwabdev keeps the Schwab login tokens (default ~/.schwabdev/tokens.db). The
# journal only reads them and never signs in; sign in with Edge Trader for Schwab's login.bat.
# SCHWAB_TOKENS_DB=
